{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "resourceGroupName": {
            "defaultValue": "",
            "type": "string"
        },
        "subscriptionId": {
            "defaultValue": "",
            "type": "string"
        },
        "tenantId": {
            "defaultValue": "",
            "type": "string"
        },
        "location": {
            "defaultValue": "",
            "type": "string"
        },
        "requestsSiteUrl": {
            "defaultValue": "",
            "type": "string"
        },
        "guestRequestsListId": {
            "defaultValue": "",
            "type": "string"
        },
        "automationAccountName": {
            "defaultValue": "",
            "type": "string"
        }
    },
    "variables": {
        "Singlequote": "'"
    },
    "resources": [
        {
            "comments": "Logic app that processes Guest Request list items by calling ProcessGuests",
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2017-07-01",
            "name": "ProcessGuestRequest",
            "location": "[parameters('location')]",
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        }
                    },
                    "triggers": {
                        "When_an_item_is_created": {
                            "recurrence": {
                                "frequency": "Minute",
                                "interval": 1
                            },
                            "evaluatedRecurrence": {
                                "frequency": "Minute",
                                "interval": 1
                            },
                            "splitOn": "@triggerBody()?['value']",
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                                    }
                                },
                                "method": "GET",
                                "path": "[concat('/datasets/@{encodeURIComponent(encodeURIComponent(',variables('singlequote'),parameters('requestsSiteUrl'),variables('singlequote'),'))}/tables/@{encodeURIComponent(encodeURIComponent(',variables('singlequote'),parameters('guestRequestsListId'),variables('singlequote'),'))}/onnewitems')]"
                            },
                            "conditions": [
                                {
                                    "expression": "@equals(triggerBody()?['Status']?['Value'],'Pending')"
                                }
                            ]
                        }
                    },
                    "actions": {
                        "Try": {
                            "type": "Scope",
                            "actions": {
                                "Process_Guests": {
                                    "runAfter": {},
                                    "type": "Workflow",
                                    "inputs": {
                                        "body": {
                                            "CompanyName": "",
                                            "EmailAccentColor": "",
                                            "Guests": "@triggerBody()?['Title']",
                                            "LogoPath": "",
                                            "SiteTitle": "@triggerBody()?['SiteTitle']",
                                            "SiteUrl": "@{triggerBody()?['SiteUrl']}",
                                            "FirstName": "@triggerBody()?['FirstName']",
                                            "LastName": "@triggerBody()?['LastName']",
                                            "Company": "@triggerBody()?['Company']"
                                        },
                                        "host": {
                                            "triggerName": "manual",
                                            "workflow": {
                                                "id": "[concat('/subscriptions/',parameters('subscriptionId'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Logic/workflows/ProcessGuests')]"
                                            }
                                        }
                                    }
                                },
                                "Parse_Guests_JSON": {
                                    "runAfter": {
                                        "Process_Guests": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "ParseJson",
                                    "inputs": {
                                        "content": "@body('Process_Guests')",
                                        "schema": {
                                            "items": {
                                                "properties": {
                                                    "GuestEmail": { "type": "string" },
                                                    "GuestId": { "type": "string" },
                                                    "InviteRedeemUrl": { "type": "string" }
                                                },
                                                "type": "object"
                                            },
                                            "type": "array"
                                        }
                                    }
                                },
                                "Set_first_guest_result": {
                                    "runAfter": {
                                        "Parse_Guests_JSON": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Compose",
                                    "inputs": "@first(body('Parse_Guests_JSON'))"
                                },
                                "Store_guest_info": {
                                    "runAfter": {
                                        "Set_first_guest_result": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                                            }
                                        },
                                        "method": "PATCH",
                                        "path": "[concat('/datasets/@{encodeURIComponent(encodeURIComponent(',variables('singlequote'),parameters('requestsSiteUrl'),variables('singlequote'),'))}/tables/@{encodeURIComponent(encodeURIComponent(',variables('singlequote'),parameters('guestRequestsListId'),variables('singlequote'),'))}/items/@{encodeURIComponent(triggerBody()?[',variables('singlequote'),'ID',variables('singlequote'),'])}')]",
                                        "body": {
                                            "Title": "@triggerBody()?['Title']",
                                            "GuestId": "@{outputs('Set_first_guest_result')?['GuestId']}",
                                            "InviteRedeemUrl": "@{outputs('Set_first_guest_result')?['InviteRedeemUrl']}",
                                            "ErrorMessage": ""
                                        }
                                    }
                                },
                                "Add_Guest_To_Site": {
                                    "runAfter": {
                                        "Store_guest_info": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['azureautomation']['connectionId']"
                                            }
                                        },
                                        "method": "PUT",
                                        "path": "[concat('/subscriptions/@{encodeURIComponent(''',parameters('subscriptionId'),''')}/resourceGroups/@{encodeURIComponent(''',parameters('resourceGroupName'),''')}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent(''',parameters('automationAccountName'),''')}/jobs')]",
                                        "queries": {
                                            "runbookName": "AddGuestToSite",
                                            "wait": true,
                                            "x-ms-api-version": "2015-10-31"
                                        },
                                        "body": {
                                            "properties": {
                                                "parameters": {
                                                    "siteUrl": "@triggerBody()?['SiteUrl']",
                                                    "guestEmail": "@triggerBody()?['Title']",
                                                    "m365GroupRole": "@{triggerBody()?['M365GroupRole']?['Value']}",
                                                    "spGroupAction": "@{triggerBody()?['SPGroupAction']?['Value']}",
                                                    "spGroupName": "@{triggerBody()?['SPGroupName']}",
                                                    "spPermissionLevel": "@{triggerBody()?['SPPermissionLevel']?['Value']}"
                                                }
                                            }
                                        }
                                    }
                                },
                                "Check_runbook_status": {
                                    "runAfter": {
                                        "Add_Guest_To_Site": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "If",
                                    "expression": {
                                        "equals": [
                                            "@body('Add_Guest_To_Site')?['properties']?['status']",
                                            "Failed"
                                        ]
                                    },
                                    "actions": {
                                        "Compose_runbook_error": {
                                            "runAfter": {},
                                            "type": "Compose",
                                            "inputs": "@{coalesce(body('Add_Guest_To_Site')?['properties']?['exception'], 'AddGuestToSite runbook failed without exception detail')}"
                                        },
                                        "Update_item_as_Runbook_Failed": {
                                            "runAfter": {
                                                "Compose_runbook_error": [
                                                    "Succeeded"
                                                ]
                                            },
                                            "type": "ApiConnection",
                                            "inputs": {
                                                "host": {
                                                    "connection": {
                                                        "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                                                    }
                                                },
                                                "method": "PATCH",
                                                "path": "[concat('/datasets/@{encodeURIComponent(encodeURIComponent(',variables('singlequote'),parameters('requestsSiteUrl'),variables('singlequote'),'))}/tables/@{encodeURIComponent(encodeURIComponent(',variables('singlequote'),parameters('guestRequestsListId'),variables('singlequote'),'))}/items/@{encodeURIComponent(triggerBody()?[',variables('singlequote'),'ID',variables('singlequote'),'])}')]",
                                                "body": {
                                                    "Title": "@triggerBody()?['Title']",
                                                    "Status": { "Value": "Failed" },
                                                    "ErrorMessage": "@{outputs('Compose_runbook_error')}"
                                                }
                                            }
                                        }
                                    },
                                    "else": {
                                        "actions": {
                                            "Update_item_as_Invited": {
                                                "runAfter": {},
                                                "type": "ApiConnection",
                                                "inputs": {
                                                    "host": {
                                                        "connection": {
                                                            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                                                        }
                                                    },
                                                    "method": "PATCH",
                                                    "path": "[concat('/datasets/@{encodeURIComponent(encodeURIComponent(',variables('singlequote'),parameters('requestsSiteUrl'),variables('singlequote'),'))}/tables/@{encodeURIComponent(encodeURIComponent(',variables('singlequote'),parameters('guestRequestsListId'),variables('singlequote'),'))}/items/@{encodeURIComponent(triggerBody()?[',variables('singlequote'),'ID',variables('singlequote'),'])}')]",
                                                    "body": {
                                                        "Title": "@triggerBody()?['Title']",
                                                        "Status": { "Value": "Invited" }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "Catch": {
                            "runAfter": {
                                "Try": [
                                    "Failed",
                                    "TimedOut"
                                ]
                            },
                            "type": "Scope",
                            "actions": {
                                "Filter_failed_actions": {
                                    "runAfter": {},
                                    "type": "Query",
                                    "inputs": {
                                        "from": "@result('Try')",
                                        "where": "@equals(item()?['status'], 'Failed')"
                                    }
                                },
                                "Compose_error_message": {
                                    "runAfter": {
                                        "Filter_failed_actions": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Compose",
                                    "inputs": "@{coalesce(first(body('Filter_failed_actions'))?['error']?['message'], first(body('Filter_failed_actions'))?['code'], 'Unknown error')}"
                                },
                                "Update_item_as_Failed": {
                                    "runAfter": {
                                        "Compose_error_message": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                                            }
                                        },
                                        "method": "PATCH",
                                        "path": "[concat('/datasets/@{encodeURIComponent(encodeURIComponent(',variables('singlequote'),parameters('requestsSiteUrl'),variables('singlequote'),'))}/tables/@{encodeURIComponent(encodeURIComponent(',variables('singlequote'),parameters('guestRequestsListId'),variables('singlequote'),'))}/items/@{encodeURIComponent(triggerBody()?[',variables('singlequote'),'ID',variables('singlequote'),'])}')]",
                                        "body": {
                                            "Title": "@triggerBody()?['Title']",
                                            "Status": { "Value": "Failed" },
                                            "ErrorMessage": "@{outputs('Compose_error_message')}"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "sharepointonline": {
                                "connectionId": "[concat('/subscriptions/',parameters('subscriptionId'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Web/connections/bestillingsportalen-spo')]",
                                "connectionName": "bestillingsportalen-spo",
                                "id": "[concat('/subscriptions/',parameters('subscriptionId'),'/providers/Microsoft.Web/locations/',parameters('location'),'/managedApis/sharepointonline')]"
                            },
                            "azureautomation": {
                                "connectionId": "[concat('/subscriptions/',parameters('subscriptionId'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Web/connections/bestillingsportalen-automation')]",
                                "connectionName": "bestillingsportalen-automation",
                                "id": "[concat('/subscriptions/',parameters('subscriptionId'),'/providers/Microsoft.Web/locations/',parameters('location'),'/managedApis/azureautomation')]"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outputs": {}
}
