{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "invite-guests-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/inviteGuests/index.js",
          "manifest": "./src/webparts/inviteGuests/manifest.json"
        }
      ]
    },
    "project-provision-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/projectProvision/index.js",
          "manifest": "./src/webparts/projectProvision/manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "ProvisionWebPartsStrings": "lib/loc/{locale}.js",
    "PropertyControlStrings": "node_modules/@pnp/spfx-property-controls/lib/loc/{locale}.js"
  }
}
