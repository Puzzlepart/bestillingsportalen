{
  "name": "bp-provision-web-parts",
  "version": "0.0.1",
  "private": true,
  "description": "SPFx web parts for Bestillingsportalen (ProjectProvision and InviteGuests)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Puzzlepart/bestillingsportalen.git",
    "directory": "Source/SharePointFramework/ProvisionWebParts"
  },
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  },
  "scripts": {
    "build": "heft test --clean --production && heft package-solution --production",
    "start": "heft start --clean",
    "clean": "heft clean",
    "test": "heft test",
    "eject-webpack": "heft eject-webpack",
    "lint": "eslint ./src --color --fix",
    "lint:check": "eslint ./src --color",
    "prettier": "prettier \"**/*.{ts,tsx,scss,json,md,yaml,yml}\" --write --log-level warn --config ../.prettierrc.yaml --ignore-path ../.prettierignore",
    "prettier:check": "prettier \"**/*.{ts,tsx,scss,json,md,yaml,yml}\" --check --config ../.prettierrc.yaml --ignore-path ../.prettierignore",
    "format": "npm run prettier && npm run lint"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.10",
    "@fluentui/react-datepicker-compat": "0.6.22",
    "@fluentui/react-icons": "^2.0.317",
    "@fluentui/react-motion-preview": "0.5.25",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-lodash-subset": "1.23.2",
    "@microsoft/sp-office-ui-fabric-core": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "@pnp/core": "^4.13.0",
    "@pnp/logging": "^4.13.0",
    "@pnp/queryable": "^4.13.0",
    "@pnp/sp": "^4.13.0",
    "@pnp/spfx-property-controls": "3.24.0",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "react-dropzone": "14.3.8",
    "react-markdown": "8.0.7",
    "rehype-raw": "6.1.1",
    "scheduler": "0.20.2",
    "shade-blend-color": "1.0.0",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@types/jest": "30.0.0",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/shade-blend-color": "1.0.3",
    "eslint": "9.37.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unused-imports": "4.2.0",
    "prettier": "3.8.3",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17"
  }
}
